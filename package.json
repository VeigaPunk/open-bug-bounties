{
  "name": "open-bug-bounties",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "refresh": "node scripts/refresh-data.mjs",
    "verify:data": "node scripts/refresh-data.mjs --verify",
    "test:unit": "node --test tests/refresh-data.test.mjs tests/agent-contract.test.mjs",
    "test": "npm run lint && npm run test:unit && npm run verify:data && npm run build && node --test tests/static-site.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "parse5": "7.3.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Open Bug Bounties"
}
